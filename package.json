{
  "name": "taskpalette-ai-d1",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "cf:dev": "npm run build && wrangler dev",
    "db:create": "wrangler d1 create taskpalette-db",
    "db:migrate:local": "wrangler d1 migrations apply taskpalette-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply taskpalette-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b --pretty"
  },
  "dependencies": {
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "latest"
  }
}
